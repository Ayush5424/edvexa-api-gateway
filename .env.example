# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edvexa_gateway
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gateway server configuration
PORT=8080

# Security and JWT configuration (required in production; minimum 32 characters / 256 bits)
# Either JWT_SECRET or GATEWAY_JWT_SECRET can be used
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_for_production
JWT_EXPIRATION_MS=86400000
GATEWAY_JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_for_production

# Administrative initial provisioning and recovery (optional, safe placeholders)
# GATEWAY_BOOTSTRAP_SECRET=replace_with_secure_bootstrap_secret_for_first_admin
# GATEWAY_ADMIN_INITIAL_USERNAME=admin
# GATEWAY_ADMIN_INITIAL_PASSWORD=replace_with_secure_initial_password
# GATEWAY_ADMIN_RESET_PASSWORD=

