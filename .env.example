# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edvexa_gateway
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gateway server configuration
PORT=8080

# Security and JWT configuration (generate a 256-bit secret for production)
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_for_production
JWT_EXPIRATION_MS=86400000
