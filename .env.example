# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edvexa_gateway
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gateway server configuration
PORT=8080

# Security and JWT configuration (required in production; minimum 32 characters / 256 bits)
# Either JWT_SECRET or GATEWAY_JWT_SECRET can be used
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_for_production
JWT_EXPIRATION_MS=86400000
GATEWAY_JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_for_production

# Administrative account provisioning and recovery
#
# Option A: Automatic startup provisioning (recommended for Docker / headless deployments)
# Set an initial username and password. On first boot, if no admin exists in the database,
# the gateway automatically provisions this account.
GATEWAY_ADMIN_INITIAL_USERNAME=admin
GATEWAY_ADMIN_INITIAL_PASSWORD=replace_with_secure_initial_admin_password

# Option B: Interactive setup via Web UI or REST endpoint (POST /api/v1/auth/bootstrap)
# When no admin exists, the Web UI automatically displays the first-time setup wizard.
# If GATEWAY_BOOTSTRAP_SECRET is configured, the setup wizard / API requires this secret.
# Leave blank in local development to permit open initial setup.
GATEWAY_BOOTSTRAP_SECRET=replace_with_secure_bootstrap_secret

# Option C: Administrator password reset / recovery
# Set this variable and restart the gateway once to reset the password for GATEWAY_ADMIN_INITIAL_USERNAME.
# Remove or clear the variable after recovery.
# GATEWAY_ADMIN_RESET_PASSWORD=replace_with_temporary_recovery_password

